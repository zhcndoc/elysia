FROM --platform=$BUILDPLATFORM oven/bun:1.4.2 AS bun

FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

COPY . .

RUN bun install --frozen-lockfile

RUN bun run build

FROM ikxin/caddy:latest

COPY --from=builder /app/docs/.vitepress/dist /usr/share/caddy

EXPOSE 8080
